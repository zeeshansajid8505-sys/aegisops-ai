# ==============================================================================
# AegisOps AI - Environment Configuration Template
# NOTE: Copy this file to .env for local development. Never commit .env files.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Core API (apps/api - NestJS)
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Frontend Web Application (apps/web - Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Background Worker (apps/worker - BullMQ)
WORKER_CONCURRENCY=5

# AI Service (apps/ai-service - FastAPI)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL Database (Docker / Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegisops_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisops_dev?schema=public

# Redis (Docker / Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Security & Authentication (JWT & Session secrets - placeholders only)
JWT_SECRET=super-secret-jwt-key-for-local-development-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-for-local-development-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Telemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090

# AI Provider Configuration (Future integration)
AI_PROVIDER=local
AI_API_KEY=your_placeholder_ai_key_do_not_commit_real_keys
